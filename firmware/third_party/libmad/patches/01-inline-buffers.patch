   }
 
-  if (frame->overlap) {
-    for (s = 0; s < 18; ++s) {
-      for (sb = 0; sb < 32; ++sb) {
-	(*frame->overlap)[0][sb][s] =
-	(*frame->overlap)[1][sb][s] = 0;
-      }
+  for (s = 0; s < 18; ++s) {
+    for (sb = 0; sb < 32; ++sb) {
+      frame->overlap[0][sb][s] =
+      frame->overlap[1][sb][s] = 0;
     }
   }
 }
