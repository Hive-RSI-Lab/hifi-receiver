diff --git a/components/driver_bt/bt_app_sink.c b/components/driver_bt/bt_app_sink.c
--- a/components/driver_bt/bt_app_sink.c
+++ b/components/driver_bt/bt_app_sink.c
@@ -747,3 +747,18 @@
 
 
 
+
+
+/* hifi: the lab's A2DP source (components/hifi/esp/lab_a2dp.c) takes the
+ * board's one A2DP role for a run (esp_a2d_sink_deinit, then the source)
+ * and gives it back with this once the source is down: the sink's callbacks
+ * and its init, as bt_av_hdl_stack_evt does them. AVRCP and the GAP
+ * callback stay as they were. */
+esp_err_t hifi_bt_sink_rearm(void) {
+	esp_err_t e;
+	if (!s_sink_active || !bt_app_a2d_data_cb) return ESP_ERR_INVALID_STATE;
+	if ((e = esp_a2d_register_callback(&bt_app_a2d_cb)) != ESP_OK) return e;
+	if ((e = esp_a2d_sink_register_data_callback(bt_app_a2d_data_cb)) != ESP_OK) return e;
+	if ((e = esp_a2d_sink_init()) != ESP_OK) return e;
+	return esp_bt_gap_set_scan_mode(ESP_BT_CONNECTABLE, ESP_BT_GENERAL_DISCOVERABLE);
+}
