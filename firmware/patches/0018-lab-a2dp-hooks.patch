@@ -210,8 +211,16 @@
  * BT sink data handler
  */
 #if CONFIG_BT_SINK
+/* hifi: the lab's A2DP experiment (components/hifi/esp/lab_a2dp.c) counts
+ * what arrives (timed before the output buffer's back-pressure), what the
+ * buffer couldn't take, and what was thrown away on purpose; weak, so only a
+ * lab image has it */
+extern void hifi_lab_a2dp_rx(int64_t t, uint32_t len, uint32_t written, bool discarded) __attribute__((weak));
 static void bt_sink_data_handler(const uint8_t *data, uint32_t len) {
-    sink_data_handler(data, len, 10);
+    int64_t t = hifi_lab_a2dp_rx ? esp_timer_get_time() : 0;
+    uint32_t written = sink_data_handler(data, len, 10);
+    if (hifi_lab_a2dp_rx)
+        hifi_lab_a2dp_rx(t, len, written, output.external != DECODE_BT || sink_state != SINK_RUNNING);
 }    
 
