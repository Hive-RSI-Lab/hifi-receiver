+# hifi: the lab's Bluetooth experiments link into the app only. hifi_lab_esp.c
+# refers to them weakly, so the recovery image (which doesn't link this
+# component) leaves out lab_bt.c/lab_ble.c/lab_a2dp.c and the Bluedroid host
+# they reach.
+if(CONFIG_HIFI_LAB AND CONFIG_BT_CLASSIC_ENABLED)
+	target_link_libraries(${COMPONENT_LIB} INTERFACE "-Wl,--undefined=lab_bt")
+	target_link_libraries(${COMPONENT_LIB} INTERFACE "-Wl,--undefined=lab_a2dp")
+endif()
+if(CONFIG_HIFI_LAB AND CONFIG_BT_BLE_ENABLED)
+	target_link_libraries(${COMPONENT_LIB} INTERFACE "-Wl,--undefined=lab_ble")
+endif()
 
