diff --git a/components/codecs/CMakeLists.txt b/components/codecs/CMakeLists.txt
--- a/components/codecs/CMakeLists.txt
+++ b/components/codecs/CMakeLists.txt
@@ -7,12 +7,23 @@ set(HIFI_MAD_DIR ${CMAKE_CURRENT_LIST_DIR}/libmad)
 set(HIFI_MAD_SRCS ${HIFI_MAD_DIR}/bit.c ${HIFI_MAD_DIR}/decoder.c ${HIFI_MAD_DIR}/fixed.c ${HIFI_MAD_DIR}/frame.c
 	${HIFI_MAD_DIR}/huffman.c ${HIFI_MAD_DIR}/layer12.c ${HIFI_MAD_DIR}/layer3.c ${HIFI_MAD_DIR}/stream.c
 	${HIFI_MAD_DIR}/synth.c ${HIFI_MAD_DIR}/timer.c ${HIFI_MAD_DIR}/version.c)
+# hifi (patch 0038): CONFIG_HIFI_PUBLISHABLE_CODECS (the makers' image) links
+# neither Helix AAC (RealNetworks' RPSL/RCSL) nor libresample16 (origin not
+# recorded), and builds libogg, Tremor, opus and libFLAC from the pinned
+# sources fetch.sh puts in xiph/ (firmware/third_party/xiph/README.md)
+if (CONFIG_HIFI_PUBLISHABLE_CODECS)
+	include(${CMAKE_CURRENT_LIST_DIR}/xiph/xiph.cmake)
+	set(HIFI_CODEC_INCS xiph/include xiph/include/vorbis . ./inc inc/alac inc/mad inc/soxr)
+else()
+	set(HIFI_XIPH_SRCS)
+	set(HIFI_CODEC_INCS . ./inc inc/alac inc/helix-aac inc/mad inc/resample16 inc/soxr inc/vorbis inc/opus)
+endif()
 idf_component_register(
 	   SRCS alac_wrapper.cpp
 	        ${HIFI_ALAC_DIR}/ALACDecoder.cpp ${HIFI_ALAC_DIR}/ALACBitUtilities.c ${HIFI_ALAC_DIR}/ag_dec.c
 	        ${HIFI_ALAC_DIR}/dp_dec.c ${HIFI_ALAC_DIR}/matrix_dec.c ${HIFI_ALAC_DIR}/EndianPortable.c
-	        ${HIFI_MAD_SRCS}
-	   INCLUDE_DIRS . ./inc inc/alac inc/helix-aac inc/mad inc/resample16 inc/soxr inc/vorbis inc/opus
+	        ${HIFI_MAD_SRCS} ${HIFI_XIPH_SRCS}
+	   INCLUDE_DIRS ${HIFI_CODEC_INCS}
 	   PRIV_INCLUDE_DIRS ${HIFI_ALAC_DIR}
 )
 target_compile_options(${COMPONENT_LIB} PRIVATE -O2 -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function -Wno-implicit-fallthrough)
@@ -21,6 +32,9 @@ target_compile_definitions(${COMPONENT_LIB} PRIVATE TARGET_RT_LITTLE_ENDIAN=1)
 # libmad reads its own config.h (the shipped libmad.a's settings: FPM_DEFAULT)
 set_source_files_properties(${HIFI_MAD_SRCS} PROPERTIES COMPILE_DEFINITIONS HAVE_CONFIG_H)
 
+if (CONFIG_HIFI_PUBLISHABLE_CODECS)
+	hifi_xiph_flags()
+else()
 if (DEFINED AAC_DISABLE_SBR)
 add_prebuilt_library(libhelix-aac 	lib/libhelix-aac.a ) 
 else ()
@@ -39,3 +53,4 @@ target_link_libraries(${COMPONENT_LIB} INTERFACE libvorbisidec)
 target_link_libraries(${COMPONENT_LIB} INTERFACE libogg)
 target_link_libraries(${COMPONENT_LIB} INTERFACE libresample16)
 target_link_libraries(${COMPONENT_LIB} INTERFACE libopus)
+endif()
diff --git a/components/squeezelite/CMakeLists.txt b/components/squeezelite/CMakeLists.txt
--- a/components/squeezelite/CMakeLists.txt
+++ b/components/squeezelite/CMakeLists.txt
@@ -35,8 +35,14 @@
 
 add_definitions(-DLINKALL -DLOOPBACK -DNO_FAAD -DEMBEDDED -DTREMOR_ONLY -DCUSTOM_VERSION=${BUILD_NUMBER})
 
+# hifi (patch 0038): the makers' image has no Helix AAC and no resample16
+if (CONFIG_HIFI_PUBLISHABLE_CODECS)
+	add_definitions(-DNO_HELIXAAC)
+endif()
 if (${DEPTH} EQUAL "32")
 	add_definitions(-DBYTES_PER_FRAME=8)
+elseif (CONFIG_HIFI_PUBLISHABLE_CODECS)
+	add_definitions(-DBYTES_PER_FRAME=4)
 else()	
 	add_definitions(-DRESAMPLE16 -DBYTES_PER_FRAME=4)
 endif()	
diff --git a/components/squeezelite/decode.c b/components/squeezelite/decode.c
--- a/components/squeezelite/decode.c
+++ b/components/squeezelite/decode.c
@@ -179,8 +179,10 @@
 		sort_codecs((include_codecs ? order_codecs - include_codecs : i), register_faad());
 #endif
 
+#ifndef NO_HELIXAAC
 	if (!strstr(exclude_codecs, "aac")	&& (!include_codecs || (order_codecs = strstr(include_codecs, "aac"))))
 		sort_codecs((include_codecs ? order_codecs - include_codecs : i), register_helixaac());
+#endif
 
 	if (!strstr(exclude_codecs, "ogg")	&& (!include_codecs || (order_codecs = strstr(include_codecs, "ogg"))))
 		sort_codecs((include_codecs ? order_codecs - include_codecs : i), register_vorbis());
diff --git a/components/squeezelite/helix-aac.c b/components/squeezelite/helix-aac.c
--- a/components/squeezelite/helix-aac.c
+++ b/components/squeezelite/helix-aac.c
@@ -22,6 +22,8 @@
 
 #include "squeezelite.h"
 
+#ifndef NO_HELIXAAC // hifi (patch 0038): the makers' image leaves Helix AAC out
+
 #include <aacdec.h>
 
 // AAC_MAX_SAMPLES is the number of samples for one channel
@@ -686,3 +688,5 @@
 	LOG_INFO("using helix-aac to decode aac");
 	return &ret;
 }
+
+#endif // NO_HELIXAAC
