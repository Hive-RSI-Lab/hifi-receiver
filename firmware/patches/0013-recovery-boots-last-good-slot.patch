+/* hifi (security.md L11): from recovery, "boot the app" means the slot that
+ * last ran well, which the receiver keeps in NVS as hifi_good_slot (setting
+ * recovery as the boot partition wiped otadata, so it can't say). Not a fixed
+ * ota_0: after an update to ota_1 that would boot the older firmware. */
+static bool hifi_slot_has_app(const esp_partition_t *p) {
+	esp_app_desc_t d;
+	return p && esp_ota_get_partition_description(p, &d) == ESP_OK;
+}
+
+/* the slots holding an app, the last good one first; returns how many */
+static int hifi_good_apps(const esp_partition_t *out[2]) {
+	const esp_partition_t *p0 = esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_0, NULL);
+	const esp_partition_t *p1 = esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_1, NULL);
+	const esp_partition_t *order[2] = {p0, p1};
+	int n = 0;
+	char *label = config_alloc_get_str("hifi_good_slot", NULL, NULL);
+	if (label && p1 && !strcmp(label, p1->label)) { order[0] = p1; order[1] = p0; }
+	free(label);
+	for (int i = 0; i < 2; i++)
+		if (hifi_slot_has_app(order[i])) out[n++] = order[i];
+	return n;
+}
+
