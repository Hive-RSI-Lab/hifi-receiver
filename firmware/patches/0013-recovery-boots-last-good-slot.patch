+	const esp_partition_t *good[2];
+	int n_good = (is_recovery_running && partition_subtype == ESP_PARTITION_SUBTYPE_APP_OTA_0) ? hifi_good_apps(good) : 0;
+	/* a slot can carry a valid header over a partial image: try the next */
+	for (int i = 0; i < n_good; i++) {
