diff --git a/components/wifi-manager/wifi_manager_http_server.c b/components/wifi-manager/wifi_manager_http_server.c
index 3ec6148..eaee1a9 100644
--- a/components/wifi-manager/wifi_manager_http_server.c
+++ b/components/wifi-manager/wifi_manager_http_server.c
@@ -40,6 +40,32 @@ static const char TAG[] = "http_server";
 /* hifi-receiver: the receiver's web app and test API (components/hifi) */
 extern void hifi_http_register(httpd_handle_t server) __attribute__((weak));
 
+/* hifi-receiver (security.md): every handler goes behind the LAN gate, which
+ * answers only requests addressed to this board (DNS rebinding) and sent from
+ * its own pages (CSRF). The captive portal's probe redirects stay open: in AP
+ * mode a phone asks for them under other sites' names. From the LAN the main
+ * app won't reboot into recovery, and recovery won't flash: it takes any
+ * image, signed or not (a new image goes in over USB or from the Hive). */
+extern esp_err_t hifi_lan_register(httpd_handle_t server, const httpd_uri_t *u) __attribute__((weak));
+
+static esp_err_t lan_refused(httpd_req_t *req) {
+	httpd_resp_set_status(req, "403 Forbidden");
+	httpd_resp_set_type(req, "application/json");
+	return httpd_resp_sendstr(req, "{\"error\":\"not from the network: use the USB console\"}");
+}
+
+static esp_err_t lan_register(httpd_handle_t server, const httpd_uri_t *u) {
+	if (!hifi_lan_register || u->handler == redirect_ev_handler || u->handler == redirect_200_ev_handler)
+		return httpd_register_uri_handler(server, u);
+	if ((u->handler == recovery_post_handler && !is_recovery_running) || u->handler == flash_post_handler) {
+		httpd_uri_t r = *u;
+		r.handler = lan_refused;
+		return hifi_lan_register(server, &r);
+	}
+	return hifi_lan_register(server, u);
+}
+#define httpd_register_uri_handler lan_register
+
 EXT_RAM_ATTR static httpd_handle_t _server;
 EXT_RAM_ATTR static int _port;
 EXT_RAM_ATTR rest_server_context_t *rest_context;
