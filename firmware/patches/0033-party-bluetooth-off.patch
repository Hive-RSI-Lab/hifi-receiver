 }
 #endif
 
+#if CONFIG_BT_SINK
+/* hifi: party switches the Bluetooth sink off on every member while it is
+ * on (Bluetooth and the group's Wi-Fi share one radio) and back on after.
+ * Waits for the stack to stop, up to about 3 s; not for the audio task */
+#include "freertos/task.h"
+extern bool bt_sink_controller_idle(void); /* driver_bt/bt_app_sink.c */
+#include "esp_wifi.h"
+static bool bt_sink_off;
+bool hifi_bt_sink_set(bool on) {
+	if (!enable_bt_sink || strcasestr(output.device, "BT")) return false;
+	if (on == !bt_sink_off) return true;
+	if (!on) {
+		LOCK_O;
+		if (output.external == DECODE_BT) {
+			_buf_flush(outputbuf);
+			if (output.state > OUTPUT_STOPPED) output.state = OUTPUT_STOPPED;
+			output.external = 0;
+			output.stop_time = gettime_ms();
+			sink_state = SINK_ABORT;
+		}
+		UNLOCK_O;
+		bt_sink_deinit();
+		bt_sink_off = true;
+		for (int i = 0; i < 30 && !bt_sink_controller_idle(); i++)
+			vTaskDelay(pdMS_TO_TICKS(100));
+		LOG_INFO("Bluetooth sink off for party");
+		return bt_sink_controller_idle();
+	}
+	if (!bt_sink_controller_idle()) return false;
+	/* the coexistence code won't start the controller with power save off */
+	wifi_ps_type_t ps;
+	if (esp_wifi_get_ps(&ps) == ESP_OK && ps == WIFI_PS_NONE) esp_wifi_set_ps(WIFI_PS_MIN_MODEM);
+	bt_sink_init(bt_sink_cmd_handler, bt_sink_data_handler);
+	bt_sink_off = false;
+	LOG_INFO("Bluetooth sink back on after party");
+	return true;
+}
+
+/* hifi: the sink is switched off by party */
+bool hifi_bt_sink_is_off(void) {
+	return bt_sink_off;
+}
+
+/* hifi: a board that boots with party on as a follower never starts the
+ * sink (called before register_external; hifi_bt_sink_set(true) starts it) */
+void hifi_bt_sink_boot_off(void) {
+	bt_sink_off = true;
+}
+#endif
