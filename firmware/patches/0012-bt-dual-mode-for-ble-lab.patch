diff --git a/components/driver_bt/bt_app_core.c b/components/driver_bt/bt_app_core.c
--- a/components/driver_bt/bt_app_core.c
+++ b/components/driver_bt/bt_app_core.c
@@ -81,7 +81,12 @@
 	
 	s_bt_app_task_queue = xQueueCreate(10, sizeof(bt_app_msg_t));
 	
+#if CONFIG_BTDM_CTRL_MODE_BTDM
+	/* hifi: the BLE lab image (board lite-lab-ble) runs the controller in
+	 * dual mode, so a BLE experiment can sit beside A2DP: keep BLE's memory */
+#else
 	esp_bt_controller_mem_release(ESP_BT_MODE_BLE);
