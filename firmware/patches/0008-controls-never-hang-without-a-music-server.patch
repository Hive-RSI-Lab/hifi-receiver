+		int err = 1;
+		socklen_t el = sizeof(err);
+		if (select(cli_sock + 1, NULL, &w, NULL, &tv) == 1) getsockopt(cli_sock, SOL_SOCKET, SO_ERROR, &err, &el);
+		r = err ? -1 : 0;
+	}
+	fcntl(cli_sock, F_SETFL, fl);
