@@ -159,6 +159,7 @@ static bool cmd_handler(raop_event_t event, ...) {
  */
 void raop_sink_deinit(void) {
 	raop_delete(raop);
+	raop = NULL; /* hifi: so the next connection can start it again */
 }	
 
 /****************************************************************************************
@@ -168,7 +169,14 @@ static void raop_sink_start(nm_state_t state_id, int sub_state) {
 	esp_netif_t* netif;
 	esp_netif_ip_info_t ipInfo = { }; 
 	uint8_t mac[6];	
-    char* sink_name = (char*) config_alloc_get_default(NVS_TYPE_STR, "airplay_name", CONFIG_AIRPLAY_NAME, 0);
+    char* sink_name;
+
+	/* hifi: once per boot, as for Spotify. A second raop_create() can't bind
+	 * port 5000 (the first listener still has it), so it returned NULL and
+	 * lost the running instance's pointer. An IP change reboots the board
+	 * (cb_connection_got_ip), so the first instance's address stays right. */
+	if (raop) return;
+	sink_name = (char*) config_alloc_get_default(NVS_TYPE_STR, "airplay_name", CONFIG_AIRPLAY_NAME, 0);
 
     netif = network_get_active_interface();
 	esp_netif_get_ip_info(netif, &ipInfo);
