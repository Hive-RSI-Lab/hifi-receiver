diff --git a/components/spotify/cspot_sink.c b/components/spotify/cspot_sink.c
index 03eddb1..8f6812e 100644
--- a/components/spotify/cspot_sink.c
+++ b/components/spotify/cspot_sink.c
@@ -162,6 +162,13 @@ static bool cmd_handler(cspot_event_t event, ...) {
 static void cspot_sink_start(nm_state_t state_id, int sub_state) {
     const char *hostname;
 
+	/* hifi: once per boot. This runs on every (re)connection, and each call
+	 * made a whole new player (a task, its mutexes and semaphores, about 730 B
+	 * of internal RAM and a 32 KB PSRAM stack) beside the old one, which never
+	 * stops: Wi-Fi drops walked the heap down. The first player stays, and its
+	 * session reconnects by itself (MercurySession::reconnect). */
+	if (cspot) return;
+
 	cmd_handler_chain = cspot_cbs.cmd;
 	network_get_hostname(&hostname);
 	
diff --git a/components/raop/raop_sink.c b/components/raop/raop_sink.c
index e5fe0fb..f7e46a7 100644
--- a/components/raop/raop_sink.c
