+void CDNAudioFile::releaseConnection() {
+  if (this->httpConnection && this->connectionClean &&
+      this->httpConnection->stream().isOpen() &&
+      this->httpConnection->stream().good()) {
+    std::scoped_lock lock(spareMutex);
+    spareConnection = std::move(this->httpConnection);
+    spareOrigin = originOf(this->cdnUrl);
+    spareSince = this->lastIo;
+  }
+  this->httpConnection.reset();
+  this->connectionClean = false;
