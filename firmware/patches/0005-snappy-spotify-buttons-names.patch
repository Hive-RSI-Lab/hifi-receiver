+// percent-decode one form field; malformed escapes are kept as they are
+static std::string formDecode(const char *src, size_t len) {
+    std::string out;
+    out.reserve(len);
+    auto hex = [](char c) -> int {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+        return -1;
+    };
+    for (size_t i = 0; i < len; i++) {
+        if (src[i] == '%' && i + 2 < len &&
+            hex(src[i + 1]) >= 0 && hex(src[i + 2]) >= 0) {
+            out += (char)(hex(src[i + 1]) << 4 | hex(src[i + 2]));
+            i += 2;
+        } else if (src[i] == '+') {
+            out += ' ';
+        } else {
+            out += src[i];
+        }
+    }
+    return out;
