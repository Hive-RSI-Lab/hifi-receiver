diff --git a/components/codecs/alac_wrapper.cpp b/components/codecs/alac_wrapper.cpp
new file mode 100644
index 0000000..e26b47c
--- /dev/null
+++ b/components/codecs/alac_wrapper.cpp
@@ -0,0 +1,141 @@
+/*****************************************************************************
+ * alac_wrapper.cpp: ALAC decoder wrapper, built from source (hifi).
+ *
+ * Replaces the prebuilt lib/libalac.a. The decoder is Apple's ALAC from
+ * cspot/bell/external/alac with the hifi bounds fixes (patch 0021). The input
+ * of every decode is copied into a buffer with zero padding past its end,
+ * because the bit readers look a few bytes ahead, and the decoder is told the
+ * real packet length rather than the PCM block size.
+ *
+ * Original wrapper (c) Philippe G. 2019, MIT License.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <new>
+
+#include "ALACDecoder.h"
+#include "ALACBitUtilities.h"
+
+#include "alac_wrapper.h"
+
+#define ALAC_INPUT_PAD 64	// zeros after the copied packet; the readers peek at most 8 bytes
+
+// Host tests: make the bytes past the pad unreadable, so a read beyond the
+// packet the decoder was given is an ASan error rather than stale data.
+#if defined(__has_feature)
+#if __has_feature(address_sanitizer)
+#define ALAC_ASAN 1
+#endif
+#endif
+#if defined(__SANITIZE_ADDRESS__) && !defined(ALAC_ASAN)
+#define ALAC_ASAN 1
+#endif
+#ifdef ALAC_ASAN
+#include <sanitizer/asan_interface.h>
+#define ALAC_POISON(p, n)	ASAN_POISON_MEMORY_REGION((p), (n))
+#define ALAC_UNPOISON(p, n)	ASAN_UNPOISON_MEMORY_REGION((p), (n))
+#else
+#define ALAC_POISON(p, n)	((void) 0)
+#define ALAC_UNPOISON(p, n)	((void) 0)
+#endif
+
+typedef struct alac_codec_s {
+	ALACDecoder *Decoder;
+	unsigned block_size;		// bytes of PCM for one packet, at least 2 channels wide
+	unsigned frames_per_packet;
+	unsigned out_channels_max;	// max(numChannels, 2)
+	unsigned bytes_per_sample;
+	unsigned in_cap;			// bytes of packet we keep; longer packets are cut
+	unsigned char *in;			// in_cap + ALAC_INPUT_PAD
+} alac_codec_t;
+
+/*----------------------------------------------------------------------------*/
+extern "C" struct alac_codec_s *alac_create_decoder(int magic_cookie_size, unsigned char *magic_cookie,
+											unsigned char *sample_size, unsigned *sample_rate,
+											unsigned char *channels, unsigned int *block_size) {
+	if (!magic_cookie || magic_cookie_size < 24) return NULL;
+
+	alac_codec_t *codec = (alac_codec_t*) calloc(1, sizeof(alac_codec_t));
+	if (!codec) return NULL;
+
+	codec->Decoder = new (std::nothrow) ALACDecoder;
+	if (!codec->Decoder || codec->Decoder->Init(magic_cookie, (uint32_t) magic_cookie_size) != ALAC_noErr) {
+		delete codec->Decoder;
+		free(codec);
+		return NULL;
+	}
+
+	ALACSpecificConfig *cfg = &codec->Decoder->mConfig;
+	codec->frames_per_packet = cfg->frameLength;
+	codec->out_channels_max = cfg->numChannels > 2 ? cfg->numChannels : 2;
+	codec->bytes_per_sample = (cfg->bitDepth + 7) / 8;
+	codec->block_size = codec->frames_per_packet * codec->out_channels_max * codec->bytes_per_sample;
+	// an ALAC packet is at most the PCM size plus a small escape header
+	codec->in_cap = codec->block_size + 64;
+	codec->in = (unsigned char*) malloc(codec->in_cap + ALAC_INPUT_PAD);
+	if (!codec->in) {
+		delete codec->Decoder;
+		free(codec);
+		return NULL;
+	}
+
+	*channels = cfg->numChannels;
+	*sample_rate = cfg->sampleRate;
+	*sample_size = cfg->bitDepth;
+	*block_size = codec->block_size;
+
+	return codec;
+}
+
+/*----------------------------------------------------------------------------*/
+extern "C" void alac_delete_decoder(struct alac_codec_s *codec) {
+	if (!codec) return;
+	delete codec->Decoder;
+	if (codec->in) ALAC_UNPOISON(codec->in, codec->in_cap + ALAC_INPUT_PAD);
+	free(codec->in);
+	free(codec);
+}
+
+/*----------------------------------------------------------------------------*/
+extern "C" bool alac_to_pcm_len(struct alac_codec_s *codec, unsigned char *input, unsigned len,
+								unsigned char *output, char channels, unsigned *out_frames) {
+	BitBuffer input_buffer;
+	uint32_t frames = 0;
+
+	if (out_frames) *out_frames = 0;
+	if (!codec || !input || !output || !out_frames) return false;
+
+	// the output buffer is block_size bytes, which holds out_channels_max channels
+	if (channels < 1 || (unsigned) channels > codec->out_channels_max) {
+		memset(output, 0, codec->block_size);
+		*out_frames = codec->frames_per_packet;
+		return false;
+	}
+
+	if (len > codec->in_cap) len = codec->in_cap;
+	ALAC_UNPOISON(codec->in, codec->in_cap + ALAC_INPUT_PAD);
+	memcpy(codec->in, input, len);
+	memset(codec->in + len, 0, ALAC_INPUT_PAD);
+	ALAC_POISON(codec->in + len + ALAC_INPUT_PAD, codec->in_cap - len);
+	BitBufferInit(&input_buffer, codec->in, len);
+
+	int32_t status = codec->Decoder->Decode(&input_buffer, output, codec->frames_per_packet, (uint32_t) channels, &frames);
+	if (status != ALAC_noErr || frames > codec->frames_per_packet) {
+		// a bad packet plays as one packet of silence, so timing holds
+		memset(output, 0, codec->block_size);
+		*out_frames = codec->frames_per_packet;
+		return false;
+	}
+
+	*out_frames = frames;
+	return true;
+}
+
+/*----------------------------------------------------------------------------*/
+// Old entry point: no length known, so assume a whole PCM block's worth of input.
+extern "C" bool alac_to_pcm(struct alac_codec_s *codec, unsigned char* input,
+							unsigned char *output, char channels, unsigned *out_frames) {
+	return alac_to_pcm_len(codec, input, codec ? codec->block_size : 0, output, channels, out_frames);
+}
