@@ -66,6 +66,10 @@
     std::atomic<bool> isPaused;
     enum states { ABORT, LINKED, DISCO };
     std::atomic<states> state;
+    // the account the running session logged in with (set by the cspot
+    // task, read by the httpd task, hence the lock)
+    std::string sessionUser;
+    std::mutex sessionMutex;
     std::string credentials;
     bool zeroConf;
     std::atomic<bool> flushed = false, notify = true;
@@ -257,6 +261,17 @@
             try {
                 blob->loadZeroconfQuery(queryMap);
                 accepted = true;
+                // another account picked the speaker while one is logged in:
+                // end that session so the run loop logs the new one in (the
+                // last to pick it gets it, as on any Spotify speaker)
+                std::unique_lock lock(sessionMutex);
+                bool other = blob->username != sessionUser;
+                lock.unlock();
+                if (state == LINKED && other) {
+                    CSPOT_LOG(info, "new Spotify user, handing the speaker over");
+                    cmdHandler(CSPOT_DISC);
+                    state = ABORT;
+                }
             } catch (const std::exception& e) {
                 CSPOT_LOG(error, "ZeroConf login refused: %s", e.what());
             }
