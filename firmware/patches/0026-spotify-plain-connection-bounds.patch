   CSPOT_LOG(debug, "Connected to spotify server");
 }
 
@@ -107,6 +114,14 @@ std::vector<uint8_t> PlainConnection::recvPacket() {
   readBlock(packetBuffer.data(), 4);
   uint32_t packetSize = ntohl(extract<uint32_t>(packetBuffer, 0));
 
+  // hifi: the size counts its own 4 bytes. One below 4 made packetSize - 4
+  // wrap to about 4 GB and readBlock wrote the socket's bytes past a 0-3 byte
+  // buffer; this read is the AP's handshake answer, before its signature is
+  // checked, so anyone on the path could send it. The answer is well under
+  // 64 KB.
+  if (packetSize < 4 || packetSize > 65536)
+    throw std::runtime_error("Bad packet size from the access point");
+
   packetBuffer.resize(packetSize, 0);
 
   // Read actual data
diff --git a/components/spotify/cspot/src/ShannonConnection.cpp b/components/spotify/cspot/src/ShannonConnection.cpp
index ebfe091..655180d 100644
--- a/components/spotify/cspot/src/ShannonConnection.cpp
