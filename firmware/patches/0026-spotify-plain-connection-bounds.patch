@@ -94,10 +97,14 @@ void PlainConnection::connect(const std::string& apAddress) {
     ::close(this->apSock);
 #endif
     apSock = -1;
-    throw std::runtime_error("Can't connect to spotify servers");
+    // hifi: try the next address; the throw is after the loop, once the
