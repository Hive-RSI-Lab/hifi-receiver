@@ -82,6 +82,10 @@ cspot::Packet ShannonConnection::recvPacket() {
 
   if (mac != mac2) {
     CSPOT_LOG(error, "Shannon read: Mac doesn't match");
+    // hifi: a packet that fails its MAC isn't from the access point (or is
+    // broken): drop the connection rather than parse it; the session
+    // reconnects (MercurySession::runTask catches this)
+    throw std::runtime_error("Shannon MAC mismatch");
   }
 
   // Update the nonce
