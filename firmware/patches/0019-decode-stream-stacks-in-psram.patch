hifi (CONFIG_HIFI_PSRAM_STACKS): the decode and stream threads' stacks in
PSRAM, about 19 KB of internal RAM back. Set by board/lite-main (the product
Lite ran out of internal RAM with Spotify playing, then panicked) and so by
every image built on it; the lab-radio image's HIFI_LAB_PSRAM_STACKS selects it.

diff --git a/components/squeezelite/decode.c b/components/squeezelite/decode.c
--- a/components/squeezelite/decode.c
+++ b/components/squeezelite/decode.c
@@ -142,7 +142,11 @@ static void sort_codecs(int pry, struct codec* ptr) {
 	}
 }
 
+#if CONFIG_HIFI_PSRAM_STACKS
+static void *psram_thread; /* hifi: its stack in PSRAM (embedded.h) */
+#else
 static thread_type thread;
+#endif
 
 void decode_init(log_level level, const char *include_codecs, const char *exclude_codecs) {
 	int i;
@@ -213,7 +217,11 @@ void decode_init(log_level level, const char *include_codecs, const char *exclud
 #ifdef PTHREAD_STACK_MIN
 	pthread_attr_setstacksize(&attr, PTHREAD_STACK_MIN + DECODE_THREAD_STACK_SIZE);
 #endif
+#if CONFIG_HIFI_PSRAM_STACKS
+	psram_thread_create(&psram_thread, decode_thread, NULL, PTHREAD_STACK_MIN + DECODE_THREAD_STACK_SIZE, "decode");
+#else
 	pthread_create_name(&thread, &attr, decode_thread, NULL, "decode");
+#endif
 	pthread_attr_destroy(&attr);
 #endif
 #if WIN
@@ -238,7 +246,9 @@ void decode_close(void) {
 	}
 	running = false;
 	UNLOCK_D;
-#if LINUX || OSX || FREEBSD || EMBEDDED
+#if CONFIG_HIFI_PSRAM_STACKS
+	psram_thread_join(psram_thread);
+#elif LINUX || OSX || FREEBSD || EMBEDDED
 	pthread_join(thread, NULL);
 #endif
 	mutex_destroy(decode.mutex);
diff --git a/components/squeezelite/embedded.c b/components/squeezelite/embedded.c
--- a/components/squeezelite/embedded.c
+++ b/components/squeezelite/embedded.c
@@ -80,6 +80,63 @@ int	pthread_create_name(pthread_t *thread, _CONST pthread_attr_t  *attr,
 	return pthread_create(thread, attr, start_routine, arg);
 }
 
+#if CONFIG_HIFI_PSRAM_STACKS
+#include "esp_heap_caps.h"
+#include "freertos/semphr.h"
+
+struct psram_thread {
+	void *(*fn)(void *);
+	void *arg;
+	SemaphoreHandle_t done;
+};
+
+static void psram_thread_main(void *p) {
+	struct psram_thread *t = p;
+	t->fn(t->arg);
+	xSemaphoreGive(t->done);
+	vTaskDelete(NULL);
+}
+
+/* the stack and control block are never freed: these threads end only at
+ * exit, and a task deleting itself is cleaned up later by the idle task.
+ * Single use: join works once per thread. Each create holds its stack and
+ * control block for good, so a restart would need to wait for
+ * eTaskGetState() == eDeleted before freeing them, and delete the semaphore. */
+int psram_thread_create(void **thread, void *(*start_routine)(void *), void *arg, size_t stack, const char *name) {
+	esp_pthread_cfg_t cfg = esp_pthread_get_default_config();
+	struct psram_thread *t = heap_caps_calloc(1, sizeof(*t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+	if (!t || !(t->done = xSemaphoreCreateBinary())) {
+		ESP_LOGE(TAG, "%s: no memory for the thread", name);
+		free(t);
+		return -1;
+	}
+	t->fn = start_routine;
+	t->arg = arg;
+	StackType_t *s = heap_caps_malloc(stack, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+	StaticTask_t *tcb = heap_caps_malloc(sizeof(StaticTask_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+	if (s && tcb && xTaskCreateStaticPinnedToCore(psram_thread_main, name, stack, t, cfg.prio, s, tcb, cfg.pin_to_core)) {
+		ESP_LOGI(TAG, "%s: %u B stack in PSRAM", name, (unsigned) stack);
+	} else {
+		heap_caps_free(s);
+		heap_caps_free(tcb);
+		if (xTaskCreatePinnedToCore(psram_thread_main, name, stack, t, cfg.prio, NULL, cfg.pin_to_core) != pdPASS) {
+			ESP_LOGE(TAG, "%s: no memory for the thread", name);
+			vSemaphoreDelete(t->done);
+			free(t);
+			return -1;
+		}
+		ESP_LOGW(TAG, "%s: no PSRAM for its stack, %u B internal", name, (unsigned) stack);
+	}
+	*thread = t;
+	return 0;
+}
+
+void psram_thread_join(void *thread) {
+	struct psram_thread *t = thread;
+	if (t) xSemaphoreTake(t->done, portMAX_DELAY);
+}
+#endif
+
 uint32_t _gettime_ms_(void) {
 	return (uint32_t) (esp_timer_get_time() / 1000);
 }
diff --git a/components/squeezelite/embedded.h b/components/squeezelite/embedded.h
--- a/components/squeezelite/embedded.h
+++ b/components/squeezelite/embedded.h
@@ -66,6 +66,18 @@ uint32_t 	_gettime_ms_(void);
 int			pthread_create_name(pthread_t *thread, _CONST pthread_attr_t  *attr, 
 				   void *(*start_routine)( void * ), void *arg, char *name);
 
+#include "sdkconfig.h"
+#if CONFIG_HIFI_PSRAM_STACKS
+/* hifi: a thread whose stack is in PSRAM (its control block stays in
+ * internal RAM), for the decode and stream threads, whose 14 and 4 KB stacks
+ * are internal RAM as pthreads. Such a thread must never touch flash, reads
+ * included (NVS, a partition, mmap or OTA: the IDF asserts its stack is
+ * internal while the cache is off), nor run ROM code or call Bluetooth or
+ * Wi-Fi APIs directly. Falls back to an internal stack if PSRAM has none. */
+int			psram_thread_create(void **thread, void *(*start_routine)(void *), void *arg, size_t stack, const char *name);
+void		psram_thread_join(void *thread);
+#endif
+
 // must provide	of #define as empty macros		
 int 		embedded_init(void);
 void 		register_external(void);
