+/****************************************************************************************
+ * hifi: who may use the output when a phone source (Bluetooth, AirPlay,
+ * Spotify) starts or acts: components/hifi/core/hifi_source.c decides. The
+ * newest phone source takes the output from another one, which is paused and
+ * let go behind a short fade (hifi_handover_quiet). Both are weak, so without
+ * them the old rule holds: the first source keeps the output while it plays
+ */
+enum { SRC_ALLOW, SRC_TAKEOVER, SRC_REFUSE, SRC_IGNORE };
+enum { SRC_EV_START, SRC_EV_OWN, SRC_EV_SESSION, SRC_EV_PLAY };
+extern int hifi_source_decide(int owner, bool busy, int own, int ev) __attribute__((weak));
+extern void hifi_handover_quiet(bool down) __attribute__((weak));
+extern bool hifi_output_flushed; /* output.c: emptied on purpose, not an underrun */
+
+static int source_decide(int own, int ev) {
+	int owner = output.external;
+	bool busy = output.state > OUTPUT_STOPPED;
+	if (hifi_source_decide) return hifi_source_decide(owner, busy, own, ev);
+	return owner != own && busy ? SRC_REFUSE : SRC_ALLOW;
+}
+
+/* the phone source old gives the output up: it is paused and let go
+ * (decode_restore) behind the fade, then the output is emptied for the new
+ * one. No lock is held, as the sinks' own handlers run synchronously.
+ * - The decision before this isn't under a lock: two phones starting in the
+ *   same instant can both take over, and the last one's start wins. A mutex
+ *   across decide and takeover could deadlock, as decode_restore calls into
+ *   the other sink's task.
+ * - The 200 ms fade blocks the calling sink's task.
+ * - The old source's own stop can arrive during the fade; it is a session
+ *   event, allowed, and only lets go of an output that is being given up.
+ * - If the old source already let go (Spotify's disconnect clears
+ *   output.external), nothing is flushed here; the new source's start
+ *   flushes the buffer itself */
+static void phone_takeover(int old, int own) {
+	bool busy = output.state > OUTPUT_STOPPED;
+	if (busy && hifi_handover_quiet) hifi_handover_quiet(true);
+	decode_restore(old);
+	LOCK_O;
+	if (output.external == old) {
+		_buf_flush(outputbuf);
+		hifi_output_flushed = true;
+		output.state = OUTPUT_STOPPED;
+		output.external = 0;
+		output.stop_time = gettime_ms();
+		sink_state = SINK_ABORT;
+	}
+	UNLOCK_O;
+	if (busy && hifi_handover_quiet) hifi_handover_quiet(false);
+	LOG_INFO("source %d took the output from %d%s", own, old, busy ? " while it played" : "");
+}
