+bool hifi_lab_cspot(int op, uint32_t rate) {
+	switch (op) {
+	case 0: return lab_cspot_cmd(CSPOT_BUSY);
+	case 1: return lab_cspot_cmd(CSPOT_START, rate);
+	case 2: return lab_cspot_cmd(CSPOT_PLAY);
+	case 3: return lab_cspot_cmd(CSPOT_PAUSE);
+	case 4: return lab_cspot_cmd(CSPOT_DISC);
+	case 5: return lab_cspot_cmd(CSPOT_STOP);
+	case 6: {
+		uint32_t ms = 0;
+		lab_cspot_cmd(CSPOT_QUERY_REMAINING, &ms);
+		return ms > 0;
