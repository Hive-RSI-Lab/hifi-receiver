+
+/* the phone source old gives the output up: it is paused and let go
+ * (decode_restore) behind the fade, then the output is emptied for the new
+ * one. No lock is held, as the sinks' own handlers run synchronously */
+static void phone_takeover(int old, int own) {
+	bool busy = output.state > OUTPUT_STOPPED;
+	if (busy && hifi_handover_quiet) hifi_handover_quiet(true);
+	decode_restore(old);
+	LOCK_O;
+	if (output.external == old) {
+		_buf_flush(outputbuf);
+		hifi_output_flushed = true;
+		output.state = OUTPUT_STOPPED;
+		output.external = 0;
+		output.stop_time = gettime_ms();
+		sink_state = SINK_ABORT;
+	}
+	UNLOCK_O;
+	if (busy && hifi_handover_quiet) hifi_handover_quiet(false);
+	LOG_INFO("source %d took the output from %d%s", own, old, busy ? " while it played" : "");
+}
