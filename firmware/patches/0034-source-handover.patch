+/****************************************************************************************
+ * hifi: who may use the output when a phone source (Bluetooth, AirPlay,
+ * Spotify) starts or acts: components/hifi/core/hifi_source.c decides. The
+ * newest phone source takes the output from another one, which is paused and
+ * let go behind a short fade (hifi_handover_quiet). Both are weak, so without
+ * them the old rule holds: the first source keeps the output while it plays
+ */
+enum { SRC_ALLOW, SRC_TAKEOVER, SRC_REFUSE, SRC_IGNORE };
+enum { SRC_EV_START, SRC_EV_OWN, SRC_EV_SESSION, SRC_EV_PLAY };
+extern int hifi_source_decide(int owner, bool busy, int own, int ev) __attribute__((weak));
+extern void hifi_handover_quiet(bool down) __attribute__((weak));
+extern bool hifi_output_flushed; /* output.c: emptied on purpose, not an underrun */
+
+static int source_decide(int own, int ev) {
+	int owner = output.external;
+	bool busy = output.state > OUTPUT_STOPPED;
+	if (hifi_source_decide) return hifi_source_decide(owner, busy, own, ev);
+	return owner != own && busy ? SRC_REFUSE : SRC_ALLOW;
