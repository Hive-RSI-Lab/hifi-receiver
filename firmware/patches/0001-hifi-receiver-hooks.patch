index b33f70a..f6413cc 100644
--- a/components/squeezelite/decode_external.c
+++ b/components/squeezelite/decode_external.c
@@ -54,7 +54,7 @@ static enum { SINK_RUNNING, SINK_ABORT, SINK_DISCARD } sink_state;
 #define LOCK_D   mutex_lock(decode.mutex);
 #define UNLOCK_D mutex_unlock(decode.mutex);
 
-enum { DECODE_BT = 1, DECODE_RAOP, DECODE_CSPOT };
+enum { DECODE_BT = 1, DECODE_RAOP, DECODE_CSPOT, DECODE_HIFI_TEST };
 
 extern struct outputstate output;
 extern struct decodestate decode;
@@ -120,6 +120,67 @@ static uint32_t sink_data_handler(const uint8_t *data, uint32_t len, int retries
     return written;
 }
 
+/****************************************************************************************
+ * hifi-receiver: test signals (components/hifi) take the output like a sink does,
+ * at unity gain so their level is what was asked for; the volume comes back after
+ */
+static u32_t hifi_gain_l, hifi_gain_r;
+
+void hifi_sink_start(u32_t rate) {
+	LOCK_D;
+	LOCK_O;
+	if (output.external != DECODE_HIFI_TEST) {
+		hifi_gain_l = output.gainL;
+		hifi_gain_r = output.gainR;
+	}
+	_buf_flush(outputbuf);
+	_buf_limit(outputbuf, 0);
+	output.next_sample_rate = output.current_sample_rate = rate;
+	output.external = DECODE_HIFI_TEST;
+	output.state = OUTPUT_RUNNING;
+	output.frames_played = 0;
+	sink_state = SINK_RUNNING;
+	output.gainL = output.gainR = FIXED_ONE;
+	if (decode.state != DECODE_STOPPED) decode.state = DECODE_ERROR;
+	UNLOCK_O;
+	UNLOCK_D;
+	LOG_INFO("hifi test signal started at %u", rate);
+}
+
+uint32_t hifi_sink_write(const uint8_t *data, uint32_t len) {
+	if (output.external != DECODE_HIFI_TEST) return 0;
+	return sink_data_handler(data, len, 10);
+}
+
+void hifi_sink_stop(void) {
+	LOCK_O;
+	if (output.external == DECODE_HIFI_TEST) {
+		_buf_flush(outputbuf);
+		output.state = OUTPUT_STOPPED;
+		output.external = 0;
+		output.stop_time = gettime_ms();
+		sink_state = SINK_ABORT;
+		output.gainL = hifi_gain_l;
+		output.gainR = hifi_gain_r;
+	}
+	UNLOCK_O;
+}
+
+/* how much test signal is queued ahead of the DAC, so the caller can keep it short */
+uint32_t hifi_sink_queued_ms(void) {
+	if (output.external != DECODE_HIFI_TEST || !output.current_sample_rate) return 0;
+	return (_buf_used(outputbuf) * 1000ULL) / (output.current_sample_rate * BYTES_PER_FRAME);
+}
+
+/* 0 idle, 1 LMS, 2 Bluetooth, 3 AirPlay, 4 Spotify, 5 test signal */
+int hifi_sink_source(void) {
+	if (output.external == DECODE_BT) return 2;
+	if (output.external == DECODE_RAOP) return 3;
+	if (output.external == DECODE_CSPOT) return 4;
+	if (output.external == DECODE_HIFI_TEST) return 5;
+	return output.state > OUTPUT_STOPPED ? 1 : 0;
+}
+
 /****************************************************************************************
  * BT sink data handler
  */
