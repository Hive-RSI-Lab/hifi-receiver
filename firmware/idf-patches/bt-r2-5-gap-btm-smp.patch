+            *p_data_length = length - 1; /* minus the length of type */
+            goto exit;
         }
         p += length - 1; /* skip the length of data */
+
+        /* Break loop if eir data is in an incorrect format,
+           as it may lead to memory overflow */
+        if ( p >= p_eir + HCI_EXT_INQ_RESPONSE_LEN - 1 ) {
