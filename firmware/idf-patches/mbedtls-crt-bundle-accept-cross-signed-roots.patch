+/* Binary search on the DER subject name; returns the bundle entry or NULL.
+ * The compare is bounded by both lengths so it never reads past either name. */
+static const uint8_t *esp_crt_find_cert(const unsigned char *name, size_t name_len)
+{
+    if (name == NULL || name_len == 0) {
+        return NULL;
+    }
+
+    int start = 0;
+    int end = s_crt_bundle.num_certs - 1;
+    int middle = (end - start) / 2;
+
+    while (start <= end) {
+        const uint8_t *cert = s_crt_bundle.crts[middle];
+        size_t cert_name_len = cert[0] << 8 | cert[1];
+
+        int cmp_res = memcmp(name, cert + CRT_HEADER_OFFSET, MIN(name_len, cert_name_len));
+        if (cmp_res == 0) {
+            return cert;
+        } else if (cmp_res < 0) {
+            end = middle - 1;
+        } else {
+            start = middle + 1;
+        }
+        middle = (start + end) / 2;
+    }
+    return NULL;
+}
